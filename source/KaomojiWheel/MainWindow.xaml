<Window x:Class="KaomojiWheel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="颜文字轮盘" WindowStyle="None" AllowsTransparency="True" Background="Transparent" FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <DropShadowEffect x:Key="Shadow" BlurRadius="16" ShadowDepth="0" Opacity="0.22" Color="#FF03050D"/>
        <SolidColorBrush x:Key="GlassPanelBrush" Color="#C8171B23"/>
        <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="#A820252E"/><Setter Property="Foreground" Value="#FFF2F3F6"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#8A858D9B" BorderThickness="1" CornerRadius="14" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#C52A303B"/><Setter TargetName="Bd" Property="BorderBrush" Value="#D5A5ACB8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SettingsNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#DDE1E8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Height" Value="38"/><Setter Property="Padding" Value="14,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid><Border x:Name="NavBd" Background="{TemplateBinding Background}" CornerRadius="10"/><Border x:Name="Accent" Width="3" Height="18" Background="#C3B7C1D0" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center" Opacity="0"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBd" Property="Background" Value="#702C323D"/></Trigger><Trigger Property="Tag" Value="Selected"><Setter TargetName="NavBd" Property="Background" Value="#A3333A47"/><Setter TargetName="Accent" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#B51D222B"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#A17F899A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="TextBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBd" Property="BorderBrush" Value="#E1B8C0CD"/><Setter TargetName="TextBd" Property="Background" Value="#D1242A34"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EFF1F5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Height="34"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="Track" Width="38" Height="22" Background="#8A3A414D" BorderBrush="#A7798392" BorderThickness="1" CornerRadius="11" VerticalAlignment="Center">
                        <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#FFE8EAF0" HorizontalAlignment="Left" Margin="2,0"/>
                    </Border>
                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#B15C687A"/><Setter TargetName="Track" Property="BorderBrush" Value="#D2AAB4C4"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#FFF0F2F6"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Width="10" Background="Transparent">
                <Border Width="4" Margin="0,3" HorizontalAlignment="Center" Background="#382E3540" CornerRadius="2"/>
                <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb x:Name="ScrollThumb" MinHeight="28" Margin="1.5,2"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#858B96A6" BorderBrush="#8ABBC3CF" BorderThickness="1" CornerRadius="4"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#B5A1ACBC"/><Setter TargetName="ThumbBody" Property="BorderBrush" Value="#D7D8DEE8"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#D0B4BFCE"/><Setter TargetName="ThumbBody" Property="BorderBrush" Value="#FFF0F3F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Grid Height="10" Background="Transparent">
                <Border Height="4" Margin="3,0" VerticalAlignment="Center" Background="#382E3540" CornerRadius="2"/>
                <Track x:Name="PART_Track" Focusable="False">
                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb MinWidth="28" Margin="2,1.5"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ThumbBody" Background="#858B96A6" BorderBrush="#8ABBC3CF" BorderThickness="1" CornerRadius="4"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#B5A1ACBC"/><Setter TargetName="ThumbBody" Property="BorderBrush" Value="#D7D8DEE8"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#D0B4BFCE"/><Setter TargetName="ThumbBody" Property="BorderBrush" Value="#FFF0F3F8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Background="Transparent" BorderThickness="0" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/><Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="GlassContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF0F2F6"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#ED171B23" BorderBrush="#C99EA7B6" BorderThickness="1.2" CornerRadius="11" Padding="{TemplateBinding Padding}" Effect="{StaticResource Shadow}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GlassMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFF0F2F6"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="142"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0,9,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ItemBody" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/></Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                    <Viewbox x:Name="SubmenuArrow" Grid.Column="1" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Path Data="M3,1.5 L7,5 L3,8.5" Stroke="#FFC9CED7" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                    </Viewbox>
                            </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" HorizontalOffset="-3" VerticalOffset="-6" PopupAnimation="Fade">
                                <Border Background="#F2171B23" BorderBrush="#D19EA7B6" BorderThickness="1.2" CornerRadius="11" Padding="5" Effect="{StaticResource Shadow}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#A33A424F"/></Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="ItemBody" Property="Background" Value="#BD3E4755"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#EFF1F5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><Border x:Name="ItemBd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><Border x:Name="DropBeforeLine" Height="3.5" Margin="2,0" Background="#FF69BEFF" CornerRadius="2" VerticalAlignment="Top" Panel.ZIndex="20" Visibility="Collapsed"/><Border x:Name="DropAfterLine" Height="3.5" Margin="2,0" Background="#FF69BEFF" CornerRadius="2" VerticalAlignment="Bottom" Panel.ZIndex="20" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBd" Property="Background" Value="#762D333E"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBd" Property="Background" Value="#B238404D"/></Trigger><Trigger Property="Tag" Value="DropBefore"><Setter TargetName="DropBeforeLine" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="Tag" Value="DropAfter"><Setter TargetName="DropAfterLine" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <DataTemplate x:Key="RepositoryOrderTemplate">
            <Grid Cursor="SizeAll"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#64343B47" BorderBrush="#A48E9AAA" BorderThickness="1" CornerRadius="7">
                    <TextBlock Text="{Binding DisplayOrder}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFF0F2F6" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
        <ControlTemplate x:Key="CircleTemplate" TargetType="Button">
            <Grid RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                <Ellipse x:Name="Orb" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}"/>
                <Ellipse IsHitTestVisible="False" Margin="3.5" Fill="Transparent" Stroke="#708F98A8" StrokeThickness="1"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="7"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Orb" Property="Fill" Value="#C52A303B"/><Setter TargetName="Orb" Property="Stroke" Value="#FFE1E4EA"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Orb" Property="Opacity" Value="0.3"/><Setter Property="Foreground" Value="#66838A9B"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid x:Name="Root" Background="#01000000">
        <Canvas x:Name="WheelCanvas"/>

        <Border x:Name="RepositoryPanel" Width="360" Height="280" Visibility="Collapsed" Background="{StaticResource GlassPanelBrush}" BorderBrush="#C3A5ADBC" BorderThickness="1.4" CornerRadius="22" Effect="{StaticResource Shadow}">
            <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/><RowDefinition Height="40"/></Grid.RowDefinitions>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GlassButton}" Padding="0" ToolTip="返回轮盘" Click="BackToWheel_Click">
                        <Viewbox Width="18" Height="18"><Path Data="M10,4 L4,10 L10,16 M4,10 L17,10" Stroke="#FFF2F3F6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
                    </Button>
                    <TextBlock x:Name="RepositoryTitle" Grid.Column="1" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="RandomButton" Grid.Column="2" Style="{StaticResource GlassButton}" Padding="0" ToolTip="随机复制" Click="Random_Click">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="M3,7 L6,7 C10,7 12,17 16,17 L21,17 M18,14 L21,17 L18,20" Stroke="#FFF2F3F6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Path Data="M3,17 L6,17 C10,17 12,7 16,7 L21,7 M18,4 L21,7 L18,10" Stroke="#FFF2F3F6" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,8"><WrapPanel x:Name="ItemsPanel" ItemWidth="154"/></ScrollViewer>
                <Button Grid.Row="2" Style="{StaticResource GlassButton}" HorizontalAlignment="Right" Click="AddItem_Click"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="19" Height="19" Margin="0,0,7,0"><Canvas Width="20" Height="20"><Path Data="M10,3.5 V16.5 M3.5,10 H16.5" Stroke="#FFF2F3F6" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="添加颜文字" VerticalAlignment="Center"/></StackPanel></Button>
            </Grid>
        </Border>

        <Border x:Name="SettingsPanel" Width="480" Height="350" Visibility="Collapsed" Background="#E0171B22" BorderBrush="#D1AAB2C0" BorderThickness="1.4" CornerRadius="22" Effect="{StaticResource Shadow}" SnapsToDevicePixels="True">
            <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="#761F242D" BorderBrush="#687A8494" BorderThickness="1" CornerRadius="15" Padding="6">
                    <StackPanel>
                        <Button Style="{StaticResource GlassButton}" Height="40" Padding="9,0" Margin="0,0,0,13" Click="BackToWheel_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Viewbox Width="16" Height="16" Margin="0,0,7,0"><Canvas Width="20" Height="20"><Path Data="M9,4 L3,10 L9,16 M3.5,10 H17" Stroke="#FFF2F3F6" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Canvas></Viewbox><TextBlock Text="返回轮盘" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="设置" Foreground="#929BAA" FontSize="12" Margin="10,0,0,7"/>
                        <Button x:Name="HotkeyTabButton" Style="{StaticResource SettingsNavButton}" Content="快捷键" Margin="0,2" Click="HotkeyTab_Click"/>
                        <Button x:Name="StartupTabButton" Style="{StaticResource SettingsNavButton}" Content="开机自启" Margin="0,2" Click="StartupTab_Click"/>
                        <Button x:Name="OrderTabButton" Style="{StaticResource SettingsNavButton}" Content="仓库顺序" Margin="0,2" Click="OrderTab_Click"/>
                        <Button x:Name="MotionTabButton" Style="{StaticResource SettingsNavButton}" Content="减少动效" Margin="0,2" Click="MotionTab_Click"/>
                        <Button x:Name="UpdateTabButton" Style="{StaticResource SettingsNavButton}" Content="软件更新" Margin="0,2" Click="UpdateTab_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#681D222A" BorderBrush="#667A8493" BorderThickness="1" CornerRadius="15" Padding="20"><Grid x:Name="SettingsContent"/></Border>
            </Grid>
        </Border>

        <Border x:Name="InputModal" Width="430" Visibility="Collapsed" Background="{StaticResource GlassPanelBrush}" BorderBrush="#BFA6B9F6" BorderThickness="1" CornerRadius="20" Effect="{StaticResource Shadow}" Padding="20" MouseLeftButtonDown="Modal_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="ModalTitle" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBox x:Name="ModalInput" Grid.Row="1" Height="48" Margin="0,16,0,0" MaxLength="100" TextWrapping="Wrap"/>
                <TextBlock x:Name="ModalError" Grid.Row="2" Foreground="#FFFF808A" MinHeight="18" Margin="0,5,0,0" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Style="{StaticResource GlassButton}" Content="取消" Margin="0,0,8,0" Click="ModalCancel_Click"/><Button Style="{StaticResource GlassButton}" Content="保存" Background="#FF5369B7" Click="ModalSave_Click"/></StackPanel>
            </Grid>
        </Border>

        <Border x:Name="OnboardingPanel" Width="390" Visibility="Collapsed" Background="{StaticResource GlassPanelBrush}" BorderBrush="#9FA6B9F6" BorderThickness="1" CornerRadius="20" Effect="{StaticResource Shadow}" Padding="22,18" MouseLeftButtonDown="Modal_MouseLeftButtonDown">
            <StackPanel><TextBlock Text="颜文字轮盘" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="随时唤出，轻松复制" Foreground="#FFABB5D0" Margin="0,3,0,14"/>
                <TextBlock Text="1   按 Ctrl + Shift + Z 唤出轮盘" Foreground="White" FontSize="14" Margin="0,5"/><TextBlock Text="2   选择一个颜文字轮盘" Foreground="White" FontSize="14" Margin="0,5"/><TextBlock Text="3   点击颜文字复制，再到任意位置粘贴" Foreground="White" FontSize="14" Margin="0,5"/>
                <Button Style="{StaticResource GlassButton}" Content="开始使用" Background="#FF5369B7" HorizontalAlignment="Right" Margin="0,5,0,0" Click="OnboardingDone_Click"/>
            </StackPanel>
        </Border>

        <Border x:Name="Toast" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,44" Background="#F2262D40" BorderBrush="#777F96DF" BorderThickness="1" CornerRadius="14" Padding="16,10" Effect="{StaticResource Shadow}"><TextBlock x:Name="ToastText" Foreground="White" FontSize="14"/></Border>
    </Grid>
</Window>
